#
# pipesix.conf.example - Example Configuration for pipesix IPv6 Tunnel
#
# This configuration file uses a simple key = value format.
# Lines starting with '#' are comments and are ignored.
# All paths are relative to the working directory unless absolute.
#
# Copy this file to /etc/pipesix/pipesix.conf and modify as needed.
#
# For a detailed explanation of all options, run: pipesix -h
#

# ---------------------------------------------------------------------------
# Operating Mode
# ---------------------------------------------------------------------------
# Set to "client" for the local machine or "server" for the VPS relay.
#
mode = client

# ---------------------------------------------------------------------------
# TUN Device Configuration
# ---------------------------------------------------------------------------
# tun_name:        Name of the TUN interface (default: tun0)
# tun_address:     IPv6 address assigned to the TUN device. It must lie
#                  inside the relay's tunnel prefix (what setup.sh routes to
#                  tun0 on the server, e.g. 2a01:d0:a33f::/48), otherwise
#                  return traffic reaches the VPS with no route back.
# tun_prefixlen:   Prefix length for the address (default: 64)
# tun_mtu:         MTU of the TUN device (default: 1500)
#
tun_name      = tun0
tun_address   = fd00:dead:beef::2
tun_prefixlen = 64
tun_mtu       = 1500

# ---------------------------------------------------------------------------
# Remote Endpoint (Client Mode)
# ---------------------------------------------------------------------------
# These settings are used when mode = client.
#
# remote_address:  IP address(es) or hostname(s) of the VPS relay. A
#                  comma-separated list is tried in order; when one stops
#                  answering, the client moves to the next one. Up to 8
#                  endpoints, all on remote_port. A changed list is applied
#                  on SIGHUP: the client reconnects and re-handshakes.
# remote_port:     UDP port of the VPS server (default: 8899)
#
remote_address = 203.0.113.1
remote_port    = 8899
#remote_address = relay-a.example, relay-b.example

# ---------------------------------------------------------------------------
# Local Bind (Server Mode)
# ---------------------------------------------------------------------------
# These settings are used when mode = server.
#
# bind_address:  IP address to bind the UDP listener (default: 0.0.0.0)
# bind_port:     UDP port to listen on (default: 8899)
#
#bind_address = 0.0.0.0
#bind_port    = 8899
#
# allow_client:  Optional comma-separated allow-list of client IPs (up to
#                64 entries). When empty, any sender may reach the tunnel.
#
#allow_client = 198.51.100.9, 2001:db8::3

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Every client has its own pre-shared key and completes a handshake that
# derives fresh per-session keys, so no key is shared between peers.
# Generate keys with: pipesix --genkey
#
# Client mode: this host's identity and key.
#
client_id = client1
secret    = replace-this-with-pipesix-genkey-output
# secret_file: read the key from a separate 0600 file instead. It wins
# over 'secret' when both are set, and is re-read on SIGHUP.
#secret_file = /etc/pipesix/client.secret
#
# user/group: after opening the TUN device and sockets, drop root to this
# POSIX account (server and client). Empty leaves the process as it is.
# The account must be able to read the configuration and any state files.
#user  = pipesix
#group = pipesix
#
# include: read another configuration file at this point, relative to this
# file's directory. Includes can nest up to 8 levels.
#include = /etc/pipesix/clients.conf
#
# Server mode: one 'client' line per admitted peer (up to 64). The id
# must match the client's client_id, and the secret is that client's
# pre-shared key. Do not share one secret between clients.
#
#client = client1: <output of "pipesix --genkey">
#client = client2: <output of "pipesix --genkey">
#
# Server-side key files keep credentials out of the main configuration.
# The file is read at load time and must be mode 0600. --stage-key writes
# <path>.next and a client_next_file line; --promote-key updates the
# current file and removes the staged line.
#client_secret_file = client1 /etc/pipesix/keys/client1.key
#client_next_file = client1 /etc/pipesix/keys/client1.key.next
#
# client_next: staged replacement key. The current key stays valid while
# it is present; 'pipesix --promote-key <id>' makes it current and
# 'pipesix --abort-key <id>' discards it. --stage-all, --promote-all and
# --abort-all apply the same operation to every client.
#client_next = client1: <new key>
#
# client_disabled / client_expires: refuse a client without deleting its
# route or quota history. Expiry accepts YYYY-MM-DD or Unix seconds.
#client_disabled = client1
#client_expires = client1 2027-01-01
#
# client_route: the inner IPv6 prefix each client owns, used to route
# return traffic. Matching is longest-prefix-first, a bare address means
# /128, and the line must follow its 'client' line. Two clients may not
# share a prefix. Without a route a client only receives return traffic
# while it is the only one connected.
#
#client_route = client1 2001:db8:1::2/128  # keep it inside tun_address' prefix
#client_route = client2 2001:db8:1:2::/64
#
# Per-client destination policy (server mode, optional). A deny always
# wins. Once a client has any client_allow entry its allow list is closed:
# destinations outside it are dropped. client_isolation additionally drops
# traffic to every other configured client's client_route. Both apply to
# client-to-server traffic and are reloaded on SIGHUP.
#
#client_allow = client1 2001:db8:100::/48
#client_deny  = client1 2001:db8:100:dead::/48
#client_isolation = off
#
# client_prefix_pool: a /64 delegation pool (server mode, optional).
# 'pipesix --add-client <id> --delegate' takes the lowest /64 that no
# client_route covers and writes it as that client's client_route, so the
# client can route a whole LAN. The delegated length is always /64, and
# the upstream must route the entire pool to the relay's tun0.
#
#client_prefix_pool = 2a01:d0:a33f:100::/56
#
# Per-client limits (server mode, optional). Both apply in both
# directions, take the client id first, and are reloaded on SIGHUP.
# 0 means unlimited and the default is no entry at all.
#
# quota_period selects the quota window: daily (default), weekly, monthly
# or custom. With custom, quota_period_days sets a length from 1 to 365
# UTC days. The period is reloadable, but keep it consistent across a restart
# when quota_state is enabled (the state file records the period kind).
#
#   client_rate_limit = <id> <kbit/s>    e.g. 50000 = 50 Mbit/s (both)
#   client_rate_limit_in  = <id> <kbit/s>  client -> relay
#   client_rate_limit_out = <id> <kbit/s>  relay -> client
#   client_quota      = <id> <MiB>       e.g. 10240 = 10 GiB per period
#   client_quota_warn = <id> <percent>   e.g. 90 = warn at 90%
#
# quota_action selects what happens after the quota (and grace) is used:
# drop (default) or throttle to quota_throttle_kbps in each direction.
# quota_grace is extra MiB allowed before that action starts.
#
#quota_period        = daily
#quota_period_days   = 14        # with quota_period = custom
#quota_action        = drop
#quota_grace         = 0
#quota_throttle_kbps = 64
#client_rate_limit   = client1 50000
#client_quota        = client1 10240
#client_quota_warn   = client1 90
#
# strict_source drops data whose inner IPv6 source is outside the client's
# client_route. It is off by default so an existing misconfigured client
# keeps working; turn it on when every client has an authoritative route.
#
#strict_source = off
#
# quota_state: file that keeps the per-client usage across a restart
# (server mode, optional). The current period's counters are restored at
# startup and the file is rewritten every 30 seconds and on shutdown. Empty
# (default) keeps the counters in memory only, so they start at zero with
# the process. The directory must exist and be writable by the server; the
# file is created with mode 0600. A changed path takes effect on SIGHUP.
#
#quota_state = /var/lib/pipesix/quota.state
#
# usage_history: append-only CSV of completed quota periods (server mode,
# optional). One row per client is written when a day or month ends, and
# at each configured period boundary. Query it with
# 'pipesix --usage --history' (add --json or --csv). The directory must
# exist and be writable; the file is created with mode 0600. Changing the
# path takes effect on SIGHUP.
#
#usage_history = /var/lib/pipesix/usage.csv

# ---------------------------------------------------------------------------
# Reliability
# ---------------------------------------------------------------------------
# keepalive:      Client keepalive interval in seconds (default: 20, 0 = off)
# peer_timeout:   Client reconnects when no traffic arrives for this many
#                 seconds (default: 120, 0 = off; requires keepalive > 0)
# session_timeout: Server drops an idle session after this many seconds
#                 (default: 120, 0 = off)
# stats_interval: Periodic statistics interval (default: 60, 0 = off)
#
keepalive       = 20
peer_timeout    = 120
session_timeout = 120
stats_interval  = 60
#
# endpoint_failback: after failing over to a later remote_address, probe
# the first endpoint in the background and return to it when it answers.
# Off by default so an ordered, metered relay list is not reordered.
# endpoint_failback_interval = 60
#
#endpoint_failback = off

# ---------------------------------------------------------------------------
# Prometheus Metrics
# ---------------------------------------------------------------------------
# metrics_address: address the metrics endpoint listens on, or empty to
#                  disable it (default). It serves GET /metrics over HTTP in
#                  the Prometheus text format. The control channel's
#                  'pipesix --metrics' prints the same body over its UNIX
#                  socket, so no port is needed for a one-off look.
# metrics_port:    port for the metrics endpoint (default: 9100)
# metrics_token:   bearer token required by GET /metrics. Empty (default)
#                  leaves the endpoint open. GET /healthz never needs it,
#                  so a probe can stay secret-free.
#
# The endpoint exposes client ids and traffic counters, so keep it on
# localhost or a private interface unless metrics_token is set.
# GET /healthz reports process liveness; GET /readyz returns 503 until the
# TUN device and socket are usable. Neither needs the token. Changing any
# metrics_* setting is applied on SIGHUP.
#
#metrics_address = 127.0.0.1
#metrics_port    = 9100
#metrics_token   = <a long random string>

# ---------------------------------------------------------------------------
# Logging Configuration
# ---------------------------------------------------------------------------
# log_level: Controls verbosity. Options: debug, info, warn, error, fatal
# log_format: text (default) or json. JSON emits one object per line with
#             time, level, file, line, func and msg fields, for journald or
#             a log agent.
#
# SIGHUP reloads log_level/log_format, keepalive, peer_timeout,
# session_timeout, stats_interval, strict_source, client_isolation,
# allow_client, quota_period/quota_action/quota_grace/quota_throttle_kbps,
# quota_state, usage_history, metrics_*, audit_log, endpoint_failback, the
# remote endpoint list on a client, and the credentials/ACLs/limits: the
# 'client'/'client_route' table plus staged keys and client state on a
# server, this client's own 'secret' and 'client_id' in client mode, so a
# key can be rotated without a restart. Interface, mode, user/group and
# bind_address changes take effect after a restart.
#
log_level  = info
log_format = text
#
# audit_log: append-only JSONL security audit. Separate from normal logs;
# created with mode 0600. Reloadable on SIGHUP.
#audit_log = /var/log/pipesix/audit.jsonl
