#
# pipesix.conf.example - Example Configuration for pipesix IPv6 Tunnel
#
# This configuration file uses a simple key = value format.
# Lines starting with '#' are comments and are ignored.
# All paths are relative to the working directory unless absolute.
#
# Copy this file to /etc/pipesix/pipesix.conf and modify as needed.
#
# For a detailed explanation of all options, run: pipesix -h
#

# ---------------------------------------------------------------------------
# Operating Mode
# ---------------------------------------------------------------------------
# Set to "client" for the local machine or "server" for the VPS relay.
#
mode = client

# ---------------------------------------------------------------------------
# TUN Device Configuration
# ---------------------------------------------------------------------------
# tun_name:        Name of the TUN interface (default: tun0)
# tun_address:     IPv6 address assigned to the TUN device
# tun_prefixlen:   Prefix length for the address (default: 64)
# tun_mtu:         MTU of the TUN device (default: 1500)
#
tun_name      = tun0
tun_address   = fd00:dead:beef::2
tun_prefixlen = 64
tun_mtu       = 1500

# ---------------------------------------------------------------------------
# Remote Endpoint (Client Mode)
# ---------------------------------------------------------------------------
# These settings are used when mode = client.
#
# remote_address:  IP address or hostname of the VPS server
# remote_port:     UDP port of the VPS server (default: 8899)
#
remote_address = 203.0.113.1
remote_port    = 8899

# ---------------------------------------------------------------------------
# Local Bind (Server Mode)
# ---------------------------------------------------------------------------
# These settings are used when mode = server.
#
# bind_address:  IP address to bind the UDP listener (default: 0.0.0.0)
# bind_port:     UDP port to listen on (default: 8899)
#
#bind_address = 0.0.0.0
#bind_port    = 8899
#
# allow_client:  Optional comma-separated allow-list of client IPs (up to
#                64 entries). When empty, any sender may reach the tunnel.
#
#allow_client = 198.51.100.9, 2001:db8::3

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Every client has its own pre-shared key and completes a handshake that
# derives fresh per-session keys, so no key is shared between peers.
# Generate keys with: pipesix --genkey
#
# Client mode: this host's identity and key.
#
client_id = client1
secret    = replace-this-with-pipesix-genkey-output
#
# Server mode: one 'client' line per admitted peer (up to 64). The id
# must match the client's client_id, and the secret is that client's
# pre-shared key. Do not share one secret between clients.
#
#client = client1: <output of "pipesix --genkey">
#client = client2: <output of "pipesix --genkey">

# ---------------------------------------------------------------------------
# Reliability
# ---------------------------------------------------------------------------
# keepalive:      Client keepalive interval in seconds (default: 20, 0 = off)
# peer_timeout:   Client reconnects when no traffic arrives for this many
#                 seconds (default: 120, 0 = off; requires keepalive > 0)
# session_timeout: Server drops an idle session after this many seconds
#                 (default: 120, 0 = off)
# stats_interval: Periodic statistics interval (default: 60, 0 = off)
#
keepalive       = 20
peer_timeout    = 120
session_timeout = 120
stats_interval  = 60

# ---------------------------------------------------------------------------
# Logging Configuration
# ---------------------------------------------------------------------------
# log_level: Controls verbosity. Options: debug, info, warn, error, fatal
#
# SIGHUP reloads log_level, keepalive, peer_timeout, session_timeout and
# stats_interval. Interface, endpoint, secret, mode and allow_client
# changes take effect after a restart.
#
log_level = info
