#
# pipesix.conf.example - Example Configuration for pipesix IPv6 Tunnel
#
# This configuration file uses a simple key = value format.
# Lines starting with '#' are comments and are ignored.
# All paths are relative to the working directory unless absolute.
#
# Copy this file to /etc/pipesix/pipesix.conf and modify as needed.
#
# For a detailed explanation of all options, run: pipesix -h
#

# ---------------------------------------------------------------------------
# Operating Mode
# ---------------------------------------------------------------------------
# Set to "client" for the local machine or "server" for the VPS relay.
#
mode = client

# ---------------------------------------------------------------------------
# TUN Device Configuration
# ---------------------------------------------------------------------------
# tun_name:        Name of the TUN interface (default: tun0)
# tun_address:     IPv6 address assigned to the TUN device. It must lie
#                  inside the relay's tunnel prefix (what setup.sh routes to
#                  tun0 on the server, e.g. 2a01:d0:a33f::/48), otherwise
#                  return traffic reaches the VPS with no route back.
# tun_prefixlen:   Prefix length for the address (default: 64)
# tun_mtu:         MTU of the TUN device (default: 1500)
#
tun_name      = tun0
tun_address   = fd00:dead:beef::2
tun_prefixlen = 64
tun_mtu       = 1500

# ---------------------------------------------------------------------------
# Remote Endpoint (Client Mode)
# ---------------------------------------------------------------------------
# These settings are used when mode = client.
#
# remote_address:  IP address or hostname of the VPS server
# remote_port:     UDP port of the VPS server (default: 8899)
#
remote_address = 203.0.113.1
remote_port    = 8899

# ---------------------------------------------------------------------------
# Local Bind (Server Mode)
# ---------------------------------------------------------------------------
# These settings are used when mode = server.
#
# bind_address:  IP address to bind the UDP listener (default: 0.0.0.0)
# bind_port:     UDP port to listen on (default: 8899)
#
#bind_address = 0.0.0.0
#bind_port    = 8899
#
# allow_client:  Optional comma-separated allow-list of client IPs (up to
#                64 entries). When empty, any sender may reach the tunnel.
#
#allow_client = 198.51.100.9, 2001:db8::3

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Every client has its own pre-shared key and completes a handshake that
# derives fresh per-session keys, so no key is shared between peers.
# Generate keys with: pipesix --genkey
#
# Client mode: this host's identity and key.
#
client_id = client1
secret    = replace-this-with-pipesix-genkey-output
#
# Server mode: one 'client' line per admitted peer (up to 64). The id
# must match the client's client_id, and the secret is that client's
# pre-shared key. Do not share one secret between clients.
#
#client = client1: <output of "pipesix --genkey">
#client = client2: <output of "pipesix --genkey">
#
# client_route: the inner IPv6 prefix each client owns, used to route
# return traffic. Matching is longest-prefix-first, a bare address means
# /128, and the line must follow its 'client' line. Two clients may not
# share a prefix. Without a route a client only receives return traffic
# while it is the only one connected.
#
#client_route = client1 2001:db8:1::2/128  # keep it inside tun_address' prefix
#client_route = client2 2001:db8:1:2::/64
#
# Per-client limits (server mode, optional). Both apply in both
# directions, are read at startup only, and take the client id first.
# 0 means unlimited and the default is no entry at all.
#
#   client_rate_limit = <id> <kbit/s>    e.g. 50000 = 50 Mbit/s
#   client_quota      = <id> <MiB/day>   e.g. 10240 = 10 GiB per day
#
#client_rate_limit = client1 50000
#client_quota      = client1 10240

# ---------------------------------------------------------------------------
# Reliability
# ---------------------------------------------------------------------------
# keepalive:      Client keepalive interval in seconds (default: 20, 0 = off)
# peer_timeout:   Client reconnects when no traffic arrives for this many
#                 seconds (default: 120, 0 = off; requires keepalive > 0)
# session_timeout: Server drops an idle session after this many seconds
#                 (default: 120, 0 = off)
# stats_interval: Periodic statistics interval (default: 60, 0 = off)
#
keepalive       = 20
peer_timeout    = 120
session_timeout = 120
stats_interval  = 60

# ---------------------------------------------------------------------------
# Prometheus Metrics
# ---------------------------------------------------------------------------
# metrics_address: address the metrics endpoint listens on, or empty to
#                  disable it (default). It serves GET /metrics over HTTP in
#                  the Prometheus text format. The control channel's
#                  'pipesix --metrics' prints the same body over its UNIX
#                  socket, so no port is needed for a one-off look.
# metrics_port:    port for the metrics endpoint (default: 9100)
# metrics_token:   bearer token required by GET /metrics. Empty (default)
#                  leaves the endpoint open. GET /healthz never needs it,
#                  so a probe can stay secret-free.
#
# The endpoint exposes client ids and traffic counters, so keep it on
# localhost or a private interface unless metrics_token is set.
#
#metrics_address = 127.0.0.1
#metrics_port    = 9100
#metrics_token   = <a long random string>

# ---------------------------------------------------------------------------
# Logging Configuration
# ---------------------------------------------------------------------------
# log_level: Controls verbosity. Options: debug, info, warn, error, fatal
#
# SIGHUP reloads log_level, keepalive, peer_timeout, session_timeout,
# stats_interval and the credentials: the 'client'/'client_route' table on
# a server, this client's own 'secret' and 'client_id' in client mode, so a
# key can be rotated without a restart. Interface, endpoint, mode and
# allow_client changes take effect after a restart.
#
log_level = info
